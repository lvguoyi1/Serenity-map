{
  "name": "serenity-learning-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "store": "node scripts/store-api.mjs",
    "mcp": "node scripts/serenity-mcp.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:ui": "vitest run src/canvas/uiSmoke.test.js",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node desktop/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tldraw/utils": "4.5.12",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tldraw": "^4.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tldraw/assets": "4.5.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "main": "desktop/main.mjs",
  "description": "Serenity Map AI thinking canvas",
  "build": {
    "appId": "com.serenitymap.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/main.mjs",
      "desktop/server.mjs",
      "desktop/settings.mjs",
      "scripts/ai-agent.mjs",
      "scripts/store-api.mjs",
      "scripts/serenity-core.mjs"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "productName": "Serenity Map"
}
